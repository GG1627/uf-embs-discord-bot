# Local settings. Fly.io uses fly.toml plus secrets set on the Fly app.
BOT_ENV=dev
EVENT_REMINDERS_ENABLED=false
DISCORD_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Leave disabled until the migration, Notion connection, and access IDs are ready.
NOTION_ENABLED=false
# Optional static cat thumbnails; blank disables artwork for local runs.
NOTION_ASSET_BASE_URL=https://embs-discord-bot.fly.dev
# Planning database from the supplied link; verify it is the actual database.
NOTION_DATABASE_ID=3f3cf102dd8780ba8e54db1d547a6617
# Optional: required if the database has multiple data sources.
NOTION_DATA_SOURCE_ID=3f3cf102-dd87-803f-a9e0-000b51a7e96a
NOTION_API_TOKEN=
NOTION_DEV_GUILD_ID=1448787554395623457
NOTION_DEV_CHANNEL_ID=1455006792403914903
# Blank dev roles: only this test server's owner can use commands, even in general.
NOTION_DEV_OFFICER_ROLE_IDS=
NOTION_PROD_GUILD_ID=1376293904227237978
NOTION_PROD_CHANNEL_ID=1565050975813763142
# Either Chair Director or Eboard grants command access in prod.
NOTION_PROD_OFFICER_ROLE_IDS=1376301509674795120,1376293904227237979

# Match the actual Notion property names (case-sensitive).
NOTION_TITLE_PROPERTY=Event Name
NOTION_STATUS_PROPERTY=Status
NOTION_DATE_PROPERTY=Event Date
NOTION_LOCATION_PROPERTY=Room Booking/Location
NOTION_DESCRIPTION_PROPERTY=Description
NOTION_PRIORITY_PROPERTY=Priority
NOTION_EVENT_TYPE_PROPERTY=Event Type
NOTION_POST_DEADLINE_PROPERTY=Post Deadline
# Sunday 10 AM Eastern; dev does not mention prod roles.
NOTION_DIGEST_ENABLED=true
# Prod only; requires explicit !notionlink mappings and real end_time values.
NOTION_COMPLETION_SYNC_ENABLED=false
NOTION_HTTP_PORT=8080
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
NOTION_WEBHOOK_PATH_SECRET=
# Usually blank: the one-time Notion verification token is stored in Supabase.
NOTION_WEBHOOK_SECRET=
# Convenience only: full webhook URL for pasting into the Notion subscription UI.
NOTION_WEBHOOK_URL=

# Optional; only needed for !notionask. Never commit real API keys.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
